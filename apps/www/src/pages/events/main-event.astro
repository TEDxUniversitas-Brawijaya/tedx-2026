---
import ClosedDoor from "@/assets/imgs/closed-door.png";
import SemiOpenedDoor from "@/assets/imgs/semi-opened-door.png";
import Window1 from "@/assets/imgs/window-1.png";
import OpenedDoor from "@/assets/imgs/opened-door.png";
import HouseNumber1 from "@/assets/imgs/house-number-1.png";
import PrintTexture1 from "@/assets/imgs/print-texture-1.png";
import Clock from "@/assets/imgs/clock.png";
import WallTexture1 from "@/assets/imgs/wall-texture-1.png";
import WhiteWallEffect1 from "@/assets/imgs/white-wall-effect-1.png";
import GreenRoomBackground1 from "@/assets/imgs/green-room-background-1.png";
import FrameEP from "@/assets/imgs/frame-ep.png";
import FrameEM from "@/assets/imgs/frame-em.png";
import FrameCEM from "@/assets/imgs/frame-cem.png";
import FrameVP from "@/assets/imgs/frame-vp.png";
import FrameSponsorship from "@/assets/imgs/frame-sponsorship.png";
import FrameCurator from "@/assets/imgs/frame-curator.png";
import FrameDesign from "@/assets/imgs/frame-design.png";
import FrameWebsite from "@/assets/imgs/frame-website.png";
import WoodFloor from "@/assets/imgs/wood-floor.png";
import Desk from "@/assets/imgs/desk.png";
import StandLamp from "@/assets/imgs/stand-lamp.png";
import TV from "@/assets/imgs/tv.png";
import Calendar24 from "@/assets/imgs/calendar-24.png";
import LogoTEDx from "@/assets/imgs/logo.png";
import PhotoFrameSpeaker from "@/assets/imgs/photo-frame-speaker.png";

import Layout from "@/components/layout.astro";
import Navbar from "@/components/navbar.astro";
import Footer from "@/components/footer.astro";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import "lenis/dist/lenis.css";

const speakerImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/imgs/speakers/*.png",
  { eager: true }
);

const speakers = [
  {
    id: "helwa",
    name: "Aniza Helwa",
    title: "Mahasiswi Universitas Brawijaya",
    description:
      "Mahasiswi Teknik Informatika yang gemar dan aktif berkecimpung dalam dunia organisasi dan komunikasi. Sebagai salah satu Awardee Tanoto Scholarship, Helwa aktif menjalani posisi Project Department sembari mengembangkan skill public speaking yang digemarinya. Kini, ia tengah mengemban peran sebagai Google Student Ambassador 2026 untuk mengintegrasikan budaya 'Psychological Safety' ke lingkup akademik. Ia ingin menciptakan ekosistem di mana setiap mahasiswa berani bereksplorasi dan berinovasi tanpa hambatan rasa takut akan kegagalan.",
    reveal_date: "2026-05-06",
  },
  {
    id: "himawan",
    name: "Himawan Adi Nugroho",
    title: "Founder Humanies Project",
    description:
      "Seorang aktivis sosial dan penggerak kemanusiaan yang dikenal sebagai Founder Humanies Project, sebuah platform yang mengonsolidasi kepedulian anak muda terhadap isu kesejahteraan dan kebijakan publik. Ia turut menjadi leader komunitas @greencitzen sebagai sebuah collective movement yang membagikan aksi-aksi mereka dalam menggerakan fandom K-Pop kepada kegiatan sosial dan kemanusiaan. Melalui rekam jejak panjang sebagai relawan, termasuk kepemimpinannya di World Cleanup Day Indonesia, Himawan kini sibuk menggerakkan ribuan relawan dalam aksi tanggap bencana dan kampanye donasi nasional.",
    reveal_date: "2026-05-09",
  },
  {
    id: "dhova",
    name: "Ramadhova Mahros Majdi",
    title: "Content Creator Specialist",
    description:
      "Akrab disapa Dhova dalam konten 'Dhova dan Maipa'. Seorang kreator konten dan figur publik yang secara konsisten mengedukasi generasi muda mengenai pentingnya kesehatan mental dan komunikasi dalam hubungan asmara. Memulai perjalanannya dari ketertarikan pada dinamika interpersonal, ia kini aktif mengelola berbagai proyek kreatif yang menyoroti bagaimana sebuah kemitraan setara dapat dibangun melalui keterbukaan.",
    reveal_date: "2026-05-10",
  },
  {
    id: "bu-zaza",
    name: "Fariza Yuniar R.",
    title: "Dosen Ilmu Komunikasi UB",
    description:
      "Seorang akademisi dan pakar Ilmu Komunikasi di Universitas Brawijaya dengan spesialisasi utama di bidang komunikasi keluarga. Sebagai peneliti, beliau secara mendalam mengeksplorasi bagaimana pola interaksi dan keterbukaan di dalam rumah tangga membentuk ketahanan mental serta identitas anggotanya. Saat ini, beliau aktif menjalankan riset serta program pengabdian masyarakat yang membekali para orang tua dengan keterampilan komunikasi strategis dalam pengasuhan. Beliau percaya bahwa rumah sejati dibangun melalui komunikasi yang hangat, menjadikan keluarga sebagai tempat kembali yang paling aman bagi setiap individu.",
    reveal_date: "2026-05-15",
  },
  {
    id: "natkeni",
    name: "Natasha Keniraras",
    title: "Finalis Miss Indonesia 2018",
    description:
      "Storyteller dan kreator konten lulusan Teknik Perkapalan Institut Teknologi Sepuluh Nopember (ITS) yang membawa perspektif unik mengenai otentisitas dan keterhubungan emosional. Memiliki latar belakang prestasi sebagai Finalis 16 Besar Miss Indonesia 2018 mewakili NTB dan bagian dari Paguyuban Cak & Ning Surabaya, ia kini dikenal luas melalui identitas 'CEO of Sexy Javanese Accent' yang ia gunakan sebagai instrumen komunikasi jujur untuk merayakan akar budayanya.",
    reveal_date: "2026-05-16",
  },
  {
    id: "leya",
    name: "Harleyava Princy",
    title: "Aktris",
    description:
      "Perempuan muda yang tumbuh dalam dunia seni peran dengan semangat eksplorasi dan ekspresi tanpa batas, Harleyava Princy atau Leya dikenal sebagai aktris dan figur publik yang menghadirkan emosi autentik melalui setiap karakter yang ia perankan. Ia mulai menapaki karier akting sejak 2023 dan semakin dikenal luas lewat perannya sebagai Cinta dalam film musikal Rangga & Cinta (2025), yang mengantarkannya meraih penghargaan Aktris Pilihan Penonton Festival Film Indonesia 2025.",
    reveal_date: "2026-05-17",
  },
];

const imageMapping: Record<string, string> = {
  helwa: "aniza.png",
  "bu-zaza": "fariza.png",
};

const currentDate = new Date();
const processedSpeakers = speakers.map((s) => {
  const isRevealed = new Date(s.reveal_date) <= currentDate;
  const baseFilename = imageMapping[s.id] || `${s.id}.png`;
  const filename = isRevealed
    ? baseFilename
    : baseFilename.replace(".png", "-unrevealed.png");

  const imageKey = `/src/assets/imgs/speakers/${filename}`;
  return {
    ...s,
    name: isRevealed ? s.name : "Coming Soon",
    title: isRevealed ? s.title : "Coming Soon",
    description: isRevealed ? s.description || "" : "Coming Soon",
    imageSrc: speakerImages[imageKey]?.default.src || "",
    isRevealed,
  };
});
---

<Layout
  title="Main Event - TEDx Universitas Brawijaya 2026"
  description="Experience the main event of TEDx Universitas Brawijaya 2026. Join us for a day of inspiring talks and ideas."
>
  <Navbar />
  <main>
    <div id="outside">
      <Image src={WhiteWallEffect1} alt="" class="white-wall-effect-1" />
      <Image src={WallTexture1} alt="" class="wall-texture-1" />
      <Image src={WallTexture1} alt="" class="wall-texture-2" />
      <div id="door-container">
        <Image
          src={OpenedDoor}
          alt="Opened Door"
          class="door"
          id="opened-door"
        />
        <Image
          src={SemiOpenedDoor}
          alt="Semi-Opened Door"
          class="door"
          id="semi-opened-door"
        />
        <Image
          src={ClosedDoor}
          alt="Closed Door"
          class="door"
          id="closed-door"
        />
      </div>

      <Image src={HouseNumber1} alt="House Number 1" class="house-number-1" />

      <Image src={Window1} alt="Window 1" class="window-1" />

      <Image src={PrintTexture1} alt="" class="print-texture-1" />

      <div class="content">
        <h2>
          Main Event <br>
          TEDxUniversitas Brawijaya,
        </h2>
        <p>
          Hadir sebagai panggung utama, ruang bertemunya ide, suara, dan
          pengalaman yang mengajakmu menepi sejenak untuk merefleksikan hidup
          sebagai perjalanan kebersamaan
        </p>
        <button id="continue-btn" type="button">Lanjutkan</button>

        <div class="background"></div>
      </div>
    </div>
    <div id="inside">
      <div class="lenis-content">
        <div id="video-teaser-anchor"></div>

        <section class="inside-section">
          <div class="overlay"></div>
          <Image src={GreenRoomBackground1} alt="" class="section-bg" />
          <div class="absolute-container">
            <Image src={Clock} alt="clock" class="clock" />
          </div>

          <div id="frames">
            <div class="frame-ep-container">
              <Image src={FrameEP} alt="Frame EP" class="frame-ep" />
            </div>
            <div class="frame-em-container">
              <Image src={FrameEM} alt="Frame EM" class="frame-em" />
            </div>
            <div class="frame-cem-container">
              <Image src={FrameCEM} alt="Frame CEM" class="frame-cem" />
            </div>
            <div class="frame-vp-container">
              <Image src={FrameVP} alt="Frame VP" class="frame-vp" />
            </div>
            <div class="frame-sponsorship-container">
              <Image
                src={FrameSponsorship}
                alt="Frame Sponsorship"
                class="frame-sponsorship"
              />
            </div>
            <div class="frame-curator-container">
              <Image
                src={FrameCurator}
                alt="Frame Curator"
                class="frame-curator"
              />
            </div>
            <div class="frame-design-container">
              <Image
                src={FrameDesign}
                alt="Frame Design"
                class="frame-design"
              />
            </div>
            <div class="frame-website-container">
              <Image
                src={FrameWebsite}
                alt="Frame Website"
                class="frame-website"
              />
            </div>
          </div>

          <div class="section-content">
            <h2>
              Bertumbuh Bersama: Cerita yang Kita Bawa, <br> Rumah yang Kita
              Cipta
            </h2>
            <p>
              Panggung ini merajut kisah tentang keluarga sebagai ruang yang
              terus dibentuk dari rasa yang dijaga, dialog yang dipertahankan,
              dan perbedaan yang perlahan dirangkul. Di sini, cerita-cerita
              beresonansi; luka menemukan tempatnya untuk singgah, tawa hadir
              dengan hangat, dan makna tumbuh perlahan, mengantar kita pulang,
              bukan pada tempat, melainkan pada kehangatan yang kita ciptakan
              bersama.
            </p>
          </div>
        </section>

        <section class="inside-section" id="room-section">
          <div class="overlay"></div>
          <Image src={GreenRoomBackground1} alt="" class="section-bg" />

          <div class="calendar-wrapper">
            <Image src={Calendar24} alt="Calendar" class="calendar-24" />
            {processedSpeakers.map(
              (speaker) =>
                speaker.isRevealed && (
                  <div
                    class={`coret coret-${new Date(speaker.reveal_date).getDate()}`}
                  />
                )
            )}
          </div>

          <div class="light-beam-wrapper">
            <div class="light-beam"></div>
          </div>
          <div class="light-pool">
            <svg
              width="100%"
              height="100%"
              viewBox="0 0 205 47"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <ellipse
                cx="102.29"
                cy="23.189"
                rx="102.465"
                ry="22.3962"
                transform="rotate(-3.43409 102.29 23.189)"
                fill="#FF9500"
              />
            </svg>
          </div>
          <Image src={StandLamp} alt="Lamp" class="stand-lamp" />

          <div class="zoom-container">
            <div class="section-content"></div>
            <Image src={TV} alt="TV" class="tv" />
            <div class="tv-screen">
              <div id="tv-content">Bertumbuh Bersama</div>
              <div
                id="tv-speaker"
                style="display: none;"
                data-speakers={JSON.stringify(processedSpeakers)}
              >
                <div class="speaker-layout">
                  <div class="speaker-card" id="speaker-card">
                    <img
                      src=""
                      alt=""
                      class="speaker-photo"
                      id="speaker-photo-img"
                    >
                    <Image
                      src={PhotoFrameSpeaker}
                      alt="Frame"
                      class="speaker-frame-bg"
                    />
                    <div class="speaker-info">
                      <h3 id="speaker-name-display"></h3>
                      <p id="speaker-title-display"></p>
                    </div>
                  </div>
                  <div class="speaker-detail-wrapper">
                    <div
                      class="speaker-detail-text"
                      id="speaker-detail-text"
                    ></div>
                  </div>
                </div>
              </div>
              <div id="tv-presale-content" style="display: none;">
                <div class="tv-presale-body">
                  <p class="presale-label">
                    {currentDate >= new Date("2026-05-17")
                      ? "Normal Ticket Main Event"
                      : "Presale Ticket Main Event"}
                  </p>
                  <p class="presale-date">
                    {currentDate >= new Date("2026-05-17")
                      ? "17 Mei - 23 Mei"
                      : "11 Mei - 16 Mei"}
                  </p>
                </div>
              </div>
            </div>
            <Image src={LogoTEDx} alt="TEDx Logo" class="tv-logo" />
            <div class="tv-controls">
              <button id="tv-prev" class="control-label">Sebelumnya</button>
              <button id="tv-detail" class="detail-btn">Detail</button>
              <button id="tv-next" class="control-label">Selanjutnya</button>
            </div>
            <Image src={Desk} alt="Desk" class="desk" />

            <div class="location-info-wrapper">
              <h2>Lokasi dan Waktu</h2>
              <div class="location-details">
                <p>Lokasi: Auditorium Widyaloka Universitas Brawijaya</p>
                <p>Waktu: 9.00 - selesai</p>
              </div>
              <a
                href="https://store.tedxuniversitasbrawijaya.com/tickets"
                class="buy-ticket-btn"
                >Buy Main Event Tickets</a
              >
            </div>
          </div>
          <Image src={WoodFloor} alt="Floor" class="wood-floor" />
        </section>

        <div id="video-teaser-floating"></div>
        <Footer />
      </div>
    </div>
  </main>
</Layout>

<style>
  main {
    background-color: var(--color-green);
    height: 100dvh;
    position: relative;
    overflow: hidden;
    padding-top: var(--navbar-height);

    transition: opacity 0.25s ease-in-out;
  }

  #outside {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    --door-height: 40dvh;
    z-index: 2;
    display: block;

    transform: scale(1);
    transform-origin: 20% 80%;

    transition:
      transform 3s ease-in-out,
      opacity 0.25s ease-in-out;
  }

  #inside {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100dvw;
    opacity: 0;
    z-index: 1;
    overflow-y: auto;
    transition: opacity 0.25s ease-in-out;
  }

  .inside-section {
    position: relative;
    height: 100dvh;
    width: 100%;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 20dvh;
    text-align: center;
    color: var(--color-white);
  }

  .inside-section .section-bg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 150vw;
    height: 190vh;
    object-fit: cover;
    pointer-events: none;
    z-index: -1;
  }

  .inside-section .section-content {
    position: relative;
    z-index: 2;
    padding: 2rem;
    max-width: 60rem;
    text-align: center;
    color: var(--color-white);
  }

  .inside-section h2 {
    font-family: var(--font-serif);
    color: white;
    font-size: 3dvh;
    margin-bottom: 1.5rem;
    line-height: 1.2;
    text-wrap: balance;
  }

  .inside-section p {
    font-family: var(--font-sans);
    font-size: 2dvh;
    width: 80%;
    color: white;
    margin: 0 auto;
    font-weight: ;
    text-wrap: pretty;
  }

  .absolute-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100dvw;
    height: 100dvh;
    pointer-events: none;
    z-index: 1;
  }

  .clock {
    position: absolute;
    height: 30dvh;
    width: auto;
    aspect-ratio: 252.73 / 253;
    object-fit: contain;
    left: 12dvh;
    bottom: 12dvh;
    display: block;
    z-index: 2;
  }

  #video-teaser-anchor {
    position: absolute;
    top: 100dvh;
    left: 0;
    width: 100%;
    height: 0;
    pointer-events: none;
  }
  /* TODO : add video */
  #video-teaser-floating {
    display: none;
    position: absolute;
    top: 120dvh;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80vw;
    max-width: 1133px;
    aspect-ratio: 1133 / 539;
    background-color: #d9d9d9;
    z-index: 50;
    opacity: 0.4;
    will-change: transform;
    transition: none;
  }

  /* ── Ornament Frames ── */
  #frames {
    position: absolute;
    bottom: -35dvh;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }

  .frame-ep-container {
    position: absolute;
    top: 6%;
    left: 50%;
    transform: translateX(-320%);
    width: auto;
    height: 16.5dvh;
    aspect-ratio: 0.72 / 1;
  }

  .frame-ep {
    width: auto;
    height: 16.5dvh;
    object-fit: cover;
    overflow: visible;
    object-position: center;
    aspect-ratio: 0.72 / 1;
  }

  .frame-em-container {
    position: absolute;
    top: 4%;
    left: 50%;
    transform: translateX(-50%);
    width: auto;
    height: 19.8dvh;
    aspect-ratio: 0.83 / 1;
  }

  .frame-em {
    width: auto;
    height: 19.8dvh;
    object-fit: cover;
    overflow: visible;
    object-position: center;
    aspect-ratio: 0.83 / 1;
  }

  .frame-cem-container {
    position: absolute;
    top: 6%;
    left: 50%;
    transform: translateX(190%);
    width: auto;
    height: 17.8dvh;
    aspect-ratio: 0.8 / 1;
  }

  .frame-cem {
    width: auto;
    height: 17.8dvh;
    object-fit: cover;
    overflow: visible;
    object-position: center;
    aspect-ratio: 0.8 / 1;
  }

  .frame-vp-container {
    position: absolute;
    top: 30%;
    left: 50%;
    transform: translateX(-260%);
    width: auto;
    height: 12.5dvh;
    aspect-ratio: 1.26 / 1;
  }

  .frame-vp {
    width: auto;
    height: 12.5dvh;
    object-fit: cover;
    overflow: visible;
    object-position: center;
    aspect-ratio: 1.26 / 1;
  }

  .frame-sponsorship-container {
    position: absolute;
    top: 32%;
    left: 50%;
    transform: translateX(-50%);
    width: auto;
    height: 11.2dvh;
    aspect-ratio: 1.35 / 1;
  }

  .frame-sponsorship {
    width: auto;
    height: 11.2dvh;
    object-fit: cover;
    overflow: visible;
    object-position: center;
    aspect-ratio: 1.35 / 1;
  }

  .frame-curator-container {
    position: absolute;
    top: 33%;
    left: 50%;
    transform: translateX(170%);
    width: auto;
    height: 11.2dvh;
    aspect-ratio: 1.38 / 1;
  }

  .frame-curator {
    width: auto;
    height: 11.2dvh;
    object-fit: cover;
    overflow: visible;
    object-position: center;
    aspect-ratio: 1.38 / 1;
  }

  .frame-design-container {
    position: absolute;
    top: 52%;
    left: 50%;
    transform: translateX(-190%);
    width: auto;
    height: 15.2dvh;
    aspect-ratio: 0.8 / 1;
  }

  .frame-design {
    width: auto;
    height: 15.2dvh;
    object-fit: cover;
    overflow: visible;
    object-position: center;
    aspect-ratio: 0.8 / 1;
  }

  .frame-website-container {
    position: absolute;
    top: 52%;
    left: 50%;
    transform: translateX(75%);
    width: auto;
    height: 15.2dvh;
    aspect-ratio: 0.8 / 1;
  }

  .frame-website {
    width: auto;
    height: 15.2dvh;
    object-fit: cover;
    overflow: visible;
    object-position: center;
    aspect-ratio: 0.8 / 1;
  }

  .inside-section:nth-child(3) .section-bg {
    transform: translate(-50%, -50%) scaleY(-1);
  }

  .inside-section:nth-child(3) {
    margin-top: -1px;
  }

  .inside-section .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      circle,
      rgba(74, 72, 117, 0) 0%,
      rgba(74, 72, 117, 1) 100%
    );
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 1;
  }

  .white-wall-effect-1 {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100dvw;
    height: 110dvh;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
    aspect-ratio: 1.78 / 1;
    z-index: 1;
  }

  .wall-texture-1 {
    position: absolute;
    top: 0;
    left: 0;
    width: 100dvw;
    height: 100dvh;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
    mix-blend-mode: soft-light;
    aspect-ratio: 1.78 / 1;
    z-index: 1;
  }

  .wall-texture-2 {
    position: absolute;
    top: 0;
    left: 0;
    width: 100dvw;
    height: 100dvh;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
    mix-blend-mode: color-burn;
    aspect-ratio: 1.78 / 1;
    opacity: 0.83;
    filter: blur(25px);
    z-index: 1;
  }

  #door-container {
    position: absolute;
    bottom: -2%;
    left: 50%;
    transform: translateX(-90%);
    width: auto;
    height: var(--door-height);
    pointer-events: none;
    object-position: center;
    aspect-ratio: 0.49 / 1;
    z-index: 2;
  }

  .door {
    position: absolute;
    width: auto;
    height: auto;
    transition: opacity 0.25s ease-in-out;
  }

  .window-1 {
    display: none;
    position: absolute;
    bottom: var(--door-height);
    left: 50%;
    transform: translate(-170%, 100%);
    width: auto;
    height: 10dvh; /* Default mobile height */
    pointer-events: none;
    aspect-ratio: 0.72 / 1;
    z-index: 5;
  }

  .house-number-1 {
    position: absolute;
    bottom: var(--door-height);
    left: 50%;
