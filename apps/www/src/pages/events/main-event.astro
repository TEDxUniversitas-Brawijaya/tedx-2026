  .coret-6 {
    top: 62%;
    left: 41%;
  }

  .coret-9 {
    top: 62%;
    left: 78.5%;
  }

  .coret-10 {
    top: 62%;
    left: 91%;
  }

  .coret-15 {
    top: 73.5%;
    left: 66%;
  }

  .coret-16 {
    top: 73.5%;
    left: 78.5%;
  }

  .coret-17 {
    top: 73.5%;
    left: 91%;
  }

  .coret-15 {
    top: 73.5%;
    left: 66%;
  }

  .coret-16 {
    top: 73.5%;
    left: 78.5%;
  }

  .coret-17 {
    top: 73.5%;
    left: 91%;
  }

  .animate-coret .coret {
    animation: drawCoret 0.8s ease-out forwards;
  }

  .animate-coret .coret-6 {
    animation-delay: 1.4s;
  }

  .animate-coret .coret-9 {
    animation-delay: 2s;
  }

  .animate-coret .coret-10 {
    animation-delay: 2.6s;
  }

  .animate-coret .coret-15 {
    animation-delay: 3.2s;
  }

  .animate-coret .coret-16 {
    animation-delay: 3.8s;
  }

  .animate-coret .coret-17 {
    animation-delay: 4.4s;
  }

  .animate-coret .coret-15 {
    animation-delay: 3.2s;
  }

  .animate-coret .coret-16 {
    animation-delay: 3.8s;
  }

  .animate-coret .coret-17 {
    animation-delay: 4.4s;
  }

  @keyframes drawCoret {
    0% {
      clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
      opacity: 1;
    }
    100% {
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
