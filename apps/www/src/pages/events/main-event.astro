  .stand-lamp {
    position: absolute;
    bottom: 5dvh;
    right: 0dvw;
    width: auto;
    height: 100dvh;
    aspect-ratio: 367 / 1009;
    object-fit: contain;
    z-index: 2;
    pointer-events: none;
    transition: all 1.5s cubic-bezier(0.45, 0, 0.55, 1);
  }

  .light-beam-wrapper {
    position: absolute;
    top: 18dvh;
    right: -22dvh;
    width: 90dvh;
    height: 50dvh;
    filter: blur(40px);
    z-index: 1;
    pointer-events: none;
    transform-origin: top center;
    opacity: 0; /* Awalnya mati */
    transition:
      opacity 0.1s,
      transform 1.5s cubic-bezier(0.45, 0, 0.55, 1);
  }

  .animate-lamp .light-beam-wrapper {
    animation: flicker 3s ease-in-out forwards;
  }

  .light-beam {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      #ff9500 0%,
      rgba(153, 89, 0, 0) 100%
    );
    clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
  }

  .light-pool {
    position: absolute;
    top: 23dvh;
    right: 12dvh;
    width: 22dvh;
    height: auto;
    filter: blur(2dvh);
    opacity: 0; /* Awalnya mati */
    z-index: 5;
    pointer-events: none;
    transform: rotate(-1deg);
    transition:
      opacity 0.1s,
      transform 1.5s cubic-bezier(0.45, 0, 0.55, 1);
  }

  .animate-lamp .light-pool {
    animation: flicker 3s ease-in-out forwards;
  }

  @keyframes flicker {
    0% {
      opacity: 0;
    }
    5% {
      opacity: 0.8;
    }
    10% {
      opacity: 0.1;
    }
    15% {
      opacity: 1;
    }
    25% {
      opacity: 0.2;
    }
    30% {
      opacity: 0.8;
    }
    35% {
      opacity: 0.1;
    }
    40% {
      opacity: 1;
    }
    100% {
      opacity: 1;
    }
  }

