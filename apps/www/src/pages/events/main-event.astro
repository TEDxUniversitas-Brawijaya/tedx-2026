        90deg,
        rgba(255, 0, 0, 0.03),
        rgba(0, 255, 0, 0.01),
        rgba(0, 0, 255, 0.03)
      );
    background-size:
      100% 3px,
      3px 100%;
    z-index: 2;
    pointer-events: none;
    opacity: 0.4;
