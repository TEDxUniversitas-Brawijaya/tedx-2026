<script>
  const delay = (ms: number): Promise<void> =>
    new Promise((resolve) => setTimeout(resolve, ms));

  (() => {
    const continueBtn = document.getElementById("continue-btn");
    const openedDoor = document.getElementById("opened-door");
    const semiOpenedDoor = document.getElementById("semi-opened-door");
    const closedDoor = document.getElementById("closed-door");

    const outside = document.getElementById("outside");
    const inside = document.getElementById("inside");

    if (
      !(
        continueBtn &&
        openedDoor &&
        semiOpenedDoor &&
        closedDoor &&
        outside &&
        inside
      )
    ) {
      return;
    }

    continueBtn.addEventListener("click", async () => {
      // 1. Initial slow zoom and fade out content
      outside.style.transition =
        "transform 5s ease-out, opacity 0.5s ease-in-out";
      outside.style.transform = "scale(1.1)";

      const content = document.querySelector(
        "#outside .content"
      ) as HTMLElement;
      if (content) {
        content.style.transition = "opacity 0.8s ease-out";
        content.style.opacity = "0";
        content.style.pointerEvents = "none";
      }

      // 2. Animate door opening
      closedDoor.style.opacity = "0";
      await delay(600);
      semiOpenedDoor.style.opacity = "0";
      await delay(600);
      openedDoor.style.opacity = "1";

      // 3. Final aggressive zoom-in
      await delay(300);
      outside.style.transition =
        "transform 2.5s cubic-bezier(0.65, 0, 0.35, 1), opacity 1s ease-in-out";
      outside.style.transform = "scale(10)";
      outside.style.opacity = "0";

      await delay(1200);
      inside.style.opacity = "1";

      await delay(1300);
      outside.style.display = "none";
    });
  })();

  // Video teaser scroll animation — only triggers after hitting scroll bottom
  (() => {
    const inside = document.getElementById("inside");
    const teaser = document.getElementById("video-teaser-floating");

    if (!(inside && teaser)) {
      return;
    }

    let overscroll = 0;
    const maxOverscroll = window.innerHeight * 0.8;
    let locked = false;

    const isScrolledToBottom = () => {
      const maxScroll = inside.scrollHeight - inside.clientHeight;
      return maxScroll > 0 && inside.scrollTop >= maxScroll * 0.9;
    };

    const updateTeaser = () => {
      const progress = Math.min(Math.max(overscroll / maxOverscroll, 0), 1);
      const width = window.innerWidth;
      const isMobile = width < 768;
      const isTablet = width >= 768 && width < 1024;

      // Tetap absolute di antara section 1 & 2 (100dvh)
      teaser.style.position = "absolute";
      if (isTablet) {
        // Posisi seragam untuk semua jenis tablet
        teaser.style.top = "85dvh";
      } else {
        teaser.style.top = isMobile ? "90svh" : "120dvh";
      }
      teaser.style.left = "50%";

      // Kita geser translateY-nya: -50% (tengah) dikurangi progress * 100vh
      // Jadi pas di-overscroll, dia bakal melesat ke atas (keluar layar)
      const extraY = progress * 100;
      teaser.style.transform = `translate(-50%, calc(-50% - ${extraY}vh))`;

      // Opacity dipaksa 40%
      teaser.style.opacity = "0.4";
    };

    window.addEventListener(
      "wheel",
      (e) => {
        const atBottom = isScrolledToBottom();

        if (atBottom && e.deltaY > 0) {
          e.preventDefault();
          locked = true;
          overscroll = Math.min(overscroll + e.deltaY, maxOverscroll);
          updateTeaser();
        } else if (locked && e.deltaY < 0) {
          e.preventDefault();
          overscroll = Math.max(overscroll + e.deltaY, 0);
          updateTeaser();
          if (overscroll <= 0) {
            locked = false;
          }
        }
      },
      { passive: false }
    );

    // Reset if user scrolls back up normally
    inside.addEventListener(
      "scroll",
      () => {
        if (!isScrolledToBottom() && overscroll > 0) {
          overscroll = 0;
          locked = false;
          updateTeaser();
        }
      },
      { passive: true }
    );

    // Touch support
    let touchStartY = 0;
    window.addEventListener(
      "touchstart",
      (e) => {
        const touch = e.touches?.[0];
        if (touch) {
          touchStartY = touch.clientY;
        }
      },
      { passive: true }
    );

    window.addEventListener(
      "touchmove",
      (e) => {
        const touch = e.touches?.[0];
        if (!touch) {
          return;
        }

        const touchY = touch.clientY;
        const deltaY = touchStartY - touchY;
        touchStartY = touchY;

        const atBottom = isScrolledToBottom();

        if (atBottom && deltaY > 0) {
          e.preventDefault();
          locked = true;
          overscroll = Math.min(overscroll + deltaY, maxOverscroll);
          updateTeaser();
        } else if (locked && deltaY < 0) {
          e.preventDefault();
          overscroll = Math.max(overscroll + deltaY, 0);
          updateTeaser();
          if (overscroll <= 0) {
            locked = false;
          }
        }
      },
      { passive: false }
    );

    updateTeaser();
  })();

  // TV Screen Content and Controls Logic
  (() => {
    const prevBtn = document.getElementById("tv-prev");
    const nextBtn = document.getElementById("tv-next");
    const detailBtn = document.getElementById("tv-detail");
    const tvContent = document.getElementById("tv-content");
    const tvSpeaker = document.getElementById("tv-speaker");
    const tvPresaleContent = document.getElementById("tv-presale-content");
    const roomSection = document.getElementById("room-section");
    const tvLogo = document.querySelector(".tv-logo") as HTMLElement;
    const speakerPhotoImg = document.getElementById(
      "speaker-photo-img"
    ) as HTMLImageElement;
    const speakerNameDisplay = document.getElementById("speaker-name-display");
    const speakerTitleDisplay = document.getElementById(
      "speaker-title-display"
    );

    if (!(prevBtn && nextBtn && detailBtn && tvContent && tvSpeaker)) {
      return;
    }

    type SpeakerState = {
      id: string;
      name: string;
      title: string;
      description: string;
      reveal_date: string;
      imageSrc: string;
      isRevealed: boolean;
    };

    type TVState =
      | { type: "text"; text: string; color: string }
      | { type: "speaker"; speaker: SpeakerState; color: string }
      | { type: "final"; color: string };

    // Embed speakers from Astro frontmatter via data attribute
    const processedSpeakers = JSON.parse(
      tvSpeaker.getAttribute("data-speakers") || "[]"
    ) as SpeakerState[];

    const states: TVState[] = [
      { type: "text", text: "Bertumbuh Bersama", color: "black" },
      { type: "text", text: "Mengenal Speaker", color: "black" },
    ];

    const speakerDetailText = document.getElementById("speaker-detail-text");

    // Append speakers to states
    for (const speaker of processedSpeakers) {
      states.push({
        type: "speaker",
        speaker,
        color: "#eb0028", // Or another color for details
      });
    }

    states.push({
      type: "final",
      color: "#eb0028",
    });

    let currentState = 0;

    const setGlitch = (active: boolean) => {
      const method = active ? "add" : "remove";
      tvContent.classList[method]("tv-glitch");
      tvSpeaker.classList[method]("tv-glitch");
      if (tvPresaleContent) {
        tvPresaleContent.classList[method]("tv-glitch");
      }
    };

    const updateSpeakerUI = (speaker: SpeakerState) => {
      tvContent.style.display = "none";
      tvSpeaker.style.display = "block";

      if (speakerPhotoImg) {
        speakerPhotoImg.src = speaker.imageSrc;
        speakerPhotoImg.classList.toggle("is-coming-soon", !speaker.isRevealed);
      }
      if (speakerNameDisplay) {
        speakerNameDisplay.textContent = speaker.name;
      }
      if (speakerTitleDisplay) {
        speakerTitleDisplay.textContent =
          speaker.id === "helwa" ? "FILKOM 2024" : speaker.title;
      }
      if (speakerDetailText) {
        speakerDetailText.textContent = speaker.description;
      }
    };

    const updateTextUI = (text: string) => {
      tvContent.style.display = "block";
      tvSpeaker.style.display = "none";
      tvContent.textContent = text;
    };

    const updateUI = async () => {
      const state = states[currentState];
      if (!state) {
        return;
      }

      tvSpeaker.classList.remove("show-detail");
      setGlitch(true);
      await delay(100);

      const isFinal = state.type === "final";

      // Toggle extra UI components based on state
      if (tvPresaleContent) {
        tvPresaleContent.style.display = isFinal ? "flex" : "none";
      }
      if (roomSection) {
        roomSection.classList.toggle("is-zoomed", isFinal);
      }
      if (tvLogo) {
        tvLogo.style.opacity = "0.8";
      }

      // Update core TV content based on type
      if (state.type === "text") {
        updateTextUI(state.text);
      } else if (state.type === "speaker") {
        updateSpeakerUI(state.speaker);
      } else if (isFinal) {
        tvContent.style.display = "none";
        tvSpeaker.style.display = "none";
      }

      (detailBtn as HTMLElement).style.backgroundColor = state.color;
      await delay(50);
      setGlitch(false);
    };

    nextBtn.addEventListener("click", () => {
      currentState = (currentState + 1) % states.length;
      updateUI();
    });

    prevBtn.addEventListener("click", () => {
      currentState = (currentState - 1 + states.length) % states.length;
      updateUI();
    });

    detailBtn.addEventListener("click", () => {
      const state = states[currentState];
      if (!state) {
        return;
      }
      if (state.type === "speaker") {
        tvSpeaker.classList.toggle("show-detail");
      }
    });

    updateUI();
  })();

  // Lamp flicker animation trigger
  (() => {
    const sections = document.querySelectorAll(".inside-section");
    const section2 = sections[1] as HTMLElement | undefined;
    if (!section2) {
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            section2.classList.add("animate-lamp", "animate-coret");
            observer.unobserve(section2);
          }
        }
      },
      { threshold: 0.5 }
    );

    observer.observe(section2);
  })();

  // Smooth Scroll with Lenis
  import Lenis from "lenis";

  (() => {
    const inside = document.getElementById("inside");
    if (!inside) {
      return;
    }

    const lenis = new Lenis({
      wrapper: inside,
      content: inside.querySelector(".lenis-content") as HTMLElement,
      lerp: 0.04,
      wheelMultiplier: 0.8,
      touchMultiplier: 1.5,
    });

    function raf(time: number) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }

    requestAnimationFrame(raf);
  })();
</script>
